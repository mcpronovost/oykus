POSTGRES_USER=oykususer
POSTGRES_PASSWORD=oykuspass
POSTGRES_DB=oykus
DATABASE_URL=postgresql://oykususer:oykuspass@postgres:5432/oykus

# Session cookie (HttpOnly). Secure flag is enabled automatically when NODE_ENV=production.
SESSION_COOKIE_NAME=oykus_session
SESSION_TTL_MS=1209600000
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20

# Client variables use a VITE_ prefix. Vite exposes them in the browser as import.meta.env.VITE_*.
