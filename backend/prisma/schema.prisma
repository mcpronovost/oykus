generator client {
  provider = "prisma-client"
  output   = "./db"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          String        @id @default(uuid(7)) @db.Uuid
  username    String        @unique
  email       String        @unique
  password    String
  name        String
  avatar      String?
  cover       String?
  sessions    Session[]
  spaces      Space[]
  memberships SpaceMember[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("core_users")
}

model Session {
  id        String   @id @default(uuid(7)) @db.Uuid
  token     String   @unique
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  userAgent String?  @map("user_agent")
  ip        String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([userId])
  @@index([expiresAt])
  @@map("core_sessions")
}

model Space {
  id          String        @id @default(uuid(7)) @db.Uuid
  name        String
  description String?
  ownerId     String        @db.Uuid
  owner       User          @relation(fields: [ownerId], references: [id])
  members     SpaceMember[]
  roles       SpaceRole[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("core_spaces")
}

model SpaceMember {
  id      String    @id @default(uuid(7)) @db.Uuid
  spaceId String    @db.Uuid
  space   Space     @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  userId  String    @db.Uuid
  user    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId  String    @db.Uuid
  role    SpaceRole @relation(fields: [roleId, spaceId], references: [id, spaceId], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([spaceId, userId])
  @@index([userId])
  @@map("core_spaces_members")
}

model SpaceRole {
  id          String                @id @default(uuid(7)) @db.Uuid
  spaceId     String                @db.Uuid
  space       Space                 @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  name        String
  description String?
  members     SpaceMember[]
  permissions SpaceRolePermission[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([id, spaceId])
  @@unique([spaceId, name])
  @@map("core_spaces_roles")
}

model SpaceRolePermission {
  id         String    @id @default(uuid(7)) @db.Uuid
  roleId     String    @db.Uuid
  role       SpaceRole @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission String

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([roleId, permission])
  @@map("core_spaces_roles_permissions")
}
