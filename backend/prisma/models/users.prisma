model User {
  id             String        @id @default(uuid(7)) @db.Uuid
  username       String        @unique
  email          String        @unique
  password       String
  name           String
  avatar         String?
  cover          String?
  currentSpaceId String?       @db.Uuid
  currentSpace   Space?        @relation("UserCurrentSpace", fields: [currentSpaceId], references: [id], onDelete: SetNull)
  sessions       Session[]
  memberships    SpaceMember[]
  ownedSpaces    Space[]       @relation("SpaceOwner")
  notes          Note[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([currentSpaceId])
  @@map("core_users")
}

model Session {
  id        String   @id @default(uuid(7)) @db.Uuid
  token     String   @unique
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  userAgent String?  @map("user_agent")
  ip        String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([userId])
  @@index([expiresAt])
  @@map("core_sessions")
}
