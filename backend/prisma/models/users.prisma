model User {
  id             String        @id @default(uuid(7)) @db.Uuid
  username       String        @unique
  email          String        @unique
  password       String
  name           String
  avatar         String?
  cover          String?

  language       String        @default("fr")
  timezone       String        @default("UTC")

  currentSpaceId String?       @db.Uuid
  currentSpace   Space?        @relation("UserCurrentSpace", fields: [currentSpaceId], references: [id], onDelete: SetNull)
  sessions       UserSession[]
  streaks        UserStreak[]
  memberships    SpaceMember[]
  ownedSpaces    Space[]       @relation("SpaceOwner")
  notes          Note[]
  encyclopediaEntriesCreated EncyclopediaEntry[] @relation("EncyclopediaEntryCreatedBy")
  encyclopediaEntriesUpdated EncyclopediaEntry[] @relation("EncyclopediaEntryUpdatedBy")
  encyclopediaEntrySectionsCreated EncyclopediaEntrySection[] @relation("EncyclopediaEntrySectionCreatedBy")
  encyclopediaEntrySectionsUpdated EncyclopediaEntrySection[] @relation("EncyclopediaEntrySectionUpdatedBy")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([currentSpaceId])
  @@map("core_users")
}

model UserSession {
  id        String   @id @default(uuid(7)) @db.Uuid
  token     String   @unique
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  userAgent String?  @map("user_agent")
  ip        String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([userId])
  @@index([expiresAt])
  @@map("core_user_sessions")
}

model UserStreak {
  id             Int       @id @default(autoincrement())
  userId         String    @db.Uuid
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentStreak  Int       @default(0) @map("current_streak")
  longestStreak  Int       @default(0) @map("longest_streak")
  lastStreakDate DateTime? @map("last_streak_date") @db.Date
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([userId])
  @@map("core_user_streaks")
}
