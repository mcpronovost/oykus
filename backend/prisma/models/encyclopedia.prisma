model EncyclopediaTopic {
  id         Int                         @id @default(autoincrement())
  slug       String                      @unique
  position   Int                         @default(0)
  categories EncyclopediaTopicCategory[]
  entries    EncyclopediaEntry[]

  @@index([position])
  @@map("features_encyclopedia_topics")
}

model EncyclopediaTopicCategory {
  id      Int                 @id @default(autoincrement())
  slug    String
  topicId Int
  topic   EncyclopediaTopic   @relation(fields: [topicId], references: [id], onDelete: Cascade)
  entries EncyclopediaEntry[]

  @@unique([topicId, slug])
  @@index([topicId])
  @@map("features_encyclopedia_topics_categories")
}

model EncyclopediaEntry {
  id         String                     @id @default(uuid(7)) @db.Uuid
  spaceId    String                     @db.Uuid
  space      Space                      @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  topicId    Int
  topic      EncyclopediaTopic          @relation(fields: [topicId], references: [id], onDelete: Restrict)
  categoryId Int?
  category   EncyclopediaTopicCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  title      String
  slug       String
  summary    String?
  sections   EncyclopediaEntrySection[]

  createdById String? @db.Uuid
  createdBy   User?   @relation("EncyclopediaEntryCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById String? @db.Uuid
  updatedBy   User?   @relation("EncyclopediaEntryUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([spaceId, topicId, slug])
  @@index([spaceId, topicId])
  @@index([spaceId, categoryId])
  @@index([createdById])
  @@index([updatedById])
  @@map("features_encyclopedia_entries")
}

model EncyclopediaEntrySection {
  id       String            @id @default(uuid(7)) @db.Uuid
  entryId  String            @db.Uuid
  entry    EncyclopediaEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  title    String
  content  String            @db.Text
  position Int               @default(0)

  createdById String? @db.Uuid
  createdBy   User?   @relation("EncyclopediaEntrySectionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById String? @db.Uuid
  updatedBy   User?   @relation("EncyclopediaEntrySectionUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([entryId])
  @@index([createdById])
  @@index([updatedById])
  @@map("features_encyclopedia_entries_sections")
}
